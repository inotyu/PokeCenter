{
  "version": 2,
  "builds": [
    {
      "src": "api/index.ts",
      "use": "@vercel/node"
    }
  ],
  "routes": [
    {
      "src": "/api/(.*)",
      "dest": "api/index.ts"
    }
  ],
  "env": {
    "DATABASE_URL": "",
    "JWT_SECRET": "",
    "JWT_EXPIRES_IN": "",
    "FRONTEND_URL": "",
    "NODE_ENV": ""
  }
}
